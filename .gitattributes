# 默认由 Git 规范化文本文件的换行
* text=auto

# 脚本必须保持 LF。CRLF + shebang 会让 vitest 转换后残留 \r，
# 导致 import 抛 SyntaxError: Invalid or unexpected token
*.mjs text eol=lf
*.sh  text eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.pptx binary
*.docx binary
*.sqlite binary
