# server/.env — 真实 key 存这里（已 gitignore），禁止提交
LLM_BASE_URL=https://api-inference.modelscope.cn/v1
LLM_API_KEY=
LLM_VISION_MODEL=Qwen/Qwen3.5-35B-A3B
LLM_TEXT_MODEL=Qwen/Qwen3.8-Flash-Next
# Nilo 单次对话/视觉规划预算，最多 25000ms；请求不自动付费重试
NILO_DIALOGUE_BUDGET_MS=18000
# v3 绘画试验：catalogue 为原流程；idea-first 为先构思、后检索少量画法。
# 首轮合成对照未证明整体质量提升，默认保持原流程。修改后重启服务。
NILO_CREATIVE_MODE=catalogue
# 每 IP 每分钟分别限流，仍受全局 RATE_LIMIT_GLOBAL 保护
RATE_LIMIT_NILO=24
RATE_LIMIT_NILO_VOICE_ASR=36
RATE_LIMIT_NILO_VOICE_TTS=36
RATE_LIMIT_NILO_CAPABILITIES=60
# 语音默认建议使用阿里百炼北京 Qwen3-ASR-Flash + Qwen3-TTS-Flash。
# 需单独申请百炼北京API Key；ModelScope密钥不能用于百炼，不复用LLM_API_KEY。
# 尚未配置VOICE_API_KEY时，仅在浏览器支持时提供语音，仍可用按钮；不保存原始录音。
VOICE_PROVIDER=dashscope
VOICE_BASE_URL=https://dashscope.aliyuncs.com
VOICE_API_KEY=
VOICE_ASR_MODEL=qwen3-asr-flash
VOICE_TTS_MODEL=qwen3-tts-flash
# Mochi（沙小弥）：支持中文、英文的童真男声。
VOICE_TTS_VOICE=Mochi
VOICE_TIMEOUT_MS=12000
# 也可设置VOICE_PROVIDER=openai-compatible，BASE_URL为供应商 /v1 地址，
# 对应 /audio/transcriptions 与 /audio/speech，模型和音色需同时改为供应商支持值。
PORT=3001
# Bocha 联网搜索（可选：仅补充家长沟通建议，不参与判定）
BOCHA_API_KEY=
BOCHA_WEB_SEARCH_URL=https://api.bochaai.com/v1/web-search
# 报告增强总等待预算；超时返回基础报告（毫秒，上限 30000）
REPORT_BUDGET_MS=20000
# 自动补齐已结束的周报/月报（北京时间），0 关闭定时任务；页面访问仍会补齐
PERIOD_REPORTS_ENABLED=1
# 文献 embedding 与视觉/文本服务独立配置
RAG_EMBED_BASE_URL=https://api-inference.modelscope.cn/v1
RAG_EMBED_API_KEY=
RAG_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# RAG_PYTHON 可指定已有 Python；默认按操作系统选择 .rag-venv 下的解释器
# RAG_PYTHON=/opt/luma/.rag-venv/bin/python
# 生产部署见 docs/部署.md：TRUST_PROXY=1、FRONTEND_DIST、DB_PATH、BACKUP_DIR、CORS_ORIGINS、RATE_LIMIT_*、ACCESS_TOKEN_TTL_MIN
